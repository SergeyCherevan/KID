<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\AvailableLanguages.json" />
    <EmbeddedResource Include="Resources\AvailableLanguages.json"
                      LogicalName="KID.Resources.AvailableLanguages.json" />
    <None Remove="Resources\KID.ico" />
    <None Remove="Resources\Menu_Edit.ico" />
    <None Remove="Resources\Menu_File.ico" />
    <None Remove="Resources\Menu_View.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- RoslynPad declares minimum Roslyn versions. Pin the complete editor/compiler
         family to one release so NuGet cannot resolve a mixed 5.3/5.9 graph. -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="RoslynPad.Editor.Windows" Version="5.0.0" />
    <PackageReference Include="RoslynPad.Roslyn" Version="5.0.0" />
    <PackageReference Include="RoslynPad.Roslyn.Windows" Version="5.0.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\KID.ico" />
    <Resource Include="Resources\Menu_Edit.ico" />
    <Resource Include="Resources\Menu_File.ico" />
    <Resource Include="Resources\Menu_View.ico" />
    <None Include="DefaultWindowConfiguration.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KID.Library\KID.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.ru.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.uk.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
  
  <PropertyGroup>
    <ApplicationIcon>Resources\KID.ico</ApplicationIcon>
    <RootNamespace>KID</RootNamespace>
  </PropertyGroup>

</Project>
