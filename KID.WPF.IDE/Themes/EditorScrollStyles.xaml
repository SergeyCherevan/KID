<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Только VS2026: стандартный WPF ScrollBar иначе оставляет светлую полосу
         в тёмном редакторе. Системные размеры и команды прокрутки сохраняются. -->
    <Style x:Key="EditorScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource TabScrollThumbBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" Margin="3" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorScrollArrowStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Frame" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource MenuItemPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VerticalEditorScrollTemplate" TargetType="ScrollBar">
        <Grid Background="{DynamicResource EditorBackgroundBrush}" RowDefinitions="Auto,*,Auto">
            <RepeatButton Grid.Row="0" Height="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"
                          Style="{StaticResource EditorScrollArrowStyle}" Command="ScrollBar.LineUpCommand"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Path Data="{DynamicResource ChevronDownSmall}" Fill="{DynamicResource TabScrollThumbBrush}"
                      Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                </Path>
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource EditorScrollThumbStyle}" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Height="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"
                          Style="{StaticResource EditorScrollArrowStyle}" Command="ScrollBar.LineDownCommand"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Path Data="{DynamicResource ChevronDownSmall}" Fill="{DynamicResource TabScrollThumbBrush}"
                      Width="12" Height="12" Stretch="Uniform" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalEditorScrollTemplate" TargetType="ScrollBar">
        <Grid Background="{DynamicResource EditorBackgroundBrush}" ColumnDefinitions="Auto,*,Auto">
            <RepeatButton Grid.Column="0" Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                          Style="{StaticResource EditorScrollArrowStyle}" Command="ScrollBar.LineLeftCommand"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Path Data="{DynamicResource ChevronRightSmall}" Fill="{DynamicResource TabScrollThumbBrush}"
                      Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                </Path>
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource EditorScrollThumbStyle}" /></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                          Style="{StaticResource EditorScrollArrowStyle}" Command="ScrollBar.LineRightCommand"
                          CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Path Data="{DynamicResource ChevronRightSmall}" Fill="{DynamicResource TabScrollThumbBrush}"
                      Width="12" Height="12" Stretch="Uniform" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
        <Setter Property="Template" Value="{StaticResource VerticalEditorScrollTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" />
                <Setter Property="Template" Value="{StaticResource HorizontalEditorScrollTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
