<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:codeEditor="clr-namespace:KID.Services.CodeEditor"
                    xmlns:roslyn="clr-namespace:RoslynPad.Editor;assembly=RoslynPad.Editor.Windows">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MenuStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <roslyn:ClassificationHighlightColors
        x:Key="{x:Static codeEditor:ClassificationHighlightColorsProvider.CodeEditorClassificationColors}" />
    
    <!-- Цвета -->
    <Color x:Key="WindowBackground">#CCD5F0</Color>
    <Color x:Key="MenuBackground">#CCD5F0</Color>
    <Color x:Key="SplitterColor">#5D6B99</Color>
    <Color x:Key="EditorBackground">White</Color>
    <Color x:Key="EditorForeground">Black</Color>
    <Color x:Key="SpecialElementsBackground">#40568D</Color>
    <Color x:Key="TextColor">Black</Color>
    <Color x:Key="ConsoleBackground">#0972C5</Color>
    <Color x:Key="ConsoleForeground">White</Color>
    <Color x:Key="CanvasBackground">#D3D3D3</Color>
    <Color x:Key="WindowBorder">#2B2B2B</Color>

    <!-- Семантические цвета меню и кнопок окна -->
    <Color x:Key="MenuPopupBackground">#F5F7FC</Color>
    <Color x:Key="MenuItemHoverBackground">#AEBCE5</Color>
    <Color x:Key="MenuItemPressedBackground">#92A4D8</Color>
    <Color x:Key="MenuItemDisabledText">#626978</Color>
    <Color x:Key="MenuBorder">#5D6B99</Color>
    <Color x:Key="MenuSeparator">#8E9CC3</Color>
    <Color x:Key="MenuIndicator">#243866</Color>
    <Color x:Key="WindowButtonHoverBackground">#BEE6FD</Color>
    <Color x:Key="WindowButtonPressedForeground">#2B3F6C</Color>

    <!-- Цвета вкладок редактора -->
    <Color x:Key="TabActiveBackground">#F5CC84</Color>
    <Color x:Key="TabInactiveBackground">#3B4F81</Color>
    <Color x:Key="TabBarBackground">#5d6b99</Color>
    <Color x:Key="TabActiveText">#2B2B2B</Color>
    <Color x:Key="TabInactiveText">#E8E8E8</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource SpecialElementsBackground}" />
    <SolidColorBrush x:Key="MenuBrush" Color="{StaticResource MenuBackground}" />
    <SolidColorBrush x:Key="SplitterBrush" Color="{StaticResource SplitterColor}" />
    <SolidColorBrush x:Key="SpecialElementsBrush" Color="{StaticResource SpecialElementsBackground}" />
    <SolidColorBrush x:Key="EditorBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource EditorForeground}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="{StaticResource ConsoleBackground}" />
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleForeground}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasBackground}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorder}" />
    <SolidColorBrush x:Key="MenuPopupBrush" Color="{StaticResource MenuPopupBackground}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{StaticResource MenuItemHoverBackground}" />
    <SolidColorBrush x:Key="MenuItemPressedBrush" Color="{StaticResource MenuItemPressedBackground}" />
    <SolidColorBrush x:Key="MenuItemDisabledTextBrush" Color="{StaticResource MenuItemDisabledText}" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource MenuBorder}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{StaticResource MenuSeparator}" />
    <SolidColorBrush x:Key="MenuIndicatorBrush" Color="{StaticResource MenuIndicator}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="{StaticResource WindowButtonHoverBackground}" />
    <SolidColorBrush x:Key="WindowButtonPressedForegroundBrush" Color="{StaticResource WindowButtonPressedForeground}" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource TabActiveBackground}" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="{StaticResource TabInactiveBackground}" />
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="{StaticResource TabBarBackground}" />
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="{StaticResource TabActiveText}" />
    <SolidColorBrush x:Key="TabInactiveTextBrush" Color="{StaticResource TabInactiveText}" />

    <!-- Стили элементов -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource EditorBrush}"/>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource SplitterBrush}" />
    </Style>

    <!-- Стиль кнопок управления -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WindowButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WindowButtonPressedForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

