<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MenuIcons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Общие шаблоны меню. Конкретные цвета намеренно находятся в словарях тем,
        а здесь используются только семантические DynamicResource-ключи.
    -->

    <sys:Boolean x:Key="ModernMenuEnabled">True</sys:Boolean>
    <ControlTemplate x:Key="TopLevelMenuHeaderTemplate" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="ItemBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource MenuItemCornerRadius}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                    <ContentPresenter x:Name="IconPresenter"
                                      ContentSource="Icon"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom"
                   PopupAnimation="Fade"
                   HorizontalOffset="{DynamicResource MenuPopupHorizontalOffset}">
                <Border Margin="{DynamicResource MenuTopPopupMargin}"
                        Padding="{DynamicResource MenuPopupPadding}"
                        Background="{DynamicResource MenuPopupBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource MenuPopupCornerRadius}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black"
                                          Opacity="{DynamicResource MenuShadowOpacity}" />
                    </Border.Effect>
                    <ScrollViewer CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsIconsVisible}" Value="False">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemPressedBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemPressedBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MenuPressedTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MenuItemDisabledTextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="TopLevelMenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="ItemBorder"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource MenuItemCornerRadius}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <ContentPresenter x:Name="IconPresenter"
                                  ContentSource="Icon"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center" />
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding InputGestureText}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MenuPressedTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MenuItemDisabledTextBrush}" />
                <Setter TargetName="IconPresenter" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="ItemBorder"
                    MinWidth="180"
                    MinHeight="{DynamicResource MenuItemMinHeight}"
                    Padding="{DynamicResource MenuSubContentPadding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource MenuItemCornerRadius}">
                <Grid Margin="{DynamicResource MenuContentMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource MenuIconColumnWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="{DynamicResource MenuArrowColumnWidth}" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter Grid.Column="0"
                                      ContentSource="Icon"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    <Path x:Name="CheckMark"
                          Grid.Column="0"
                          Width="{DynamicResource MenuCheckWidth}"
                          Height="{DynamicResource MenuCheckHeight}"
                          Data="{DynamicResource MenuCheckGeometry}"
                          Stroke="{DynamicResource MenuCheckStrokeBrush}"
                          Fill="{DynamicResource MenuCheckFillBrush}"
                          StrokeThickness="{DynamicResource MenuCheckStrokeWidth}"
                          StrokeEndLineCap="Square"
                          Visibility="Collapsed" />
                    <ContentPresenter Grid.Column="1"
                                      Margin="{DynamicResource MenuTextMargin}"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Margin="{DynamicResource MenuGestureMargin}"
                               Foreground="{TemplateBinding Foreground}"
                               Text="{TemplateBinding InputGestureText}"
                               VerticalAlignment="Center" />
                    <Path Grid.Column="3"
                          Width="{DynamicResource MenuChevronWidth}"
                          Height="{DynamicResource MenuChevronHeight}"
                          Data="{DynamicResource MenuChevronGeometry}"
                          Stroke="{DynamicResource MenuChevronStrokeBrush}"
                          Fill="{DynamicResource MenuChevronFillBrush}"
                          StrokeThickness="{DynamicResource MenuChevronStrokeWidth}"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right"
                   PopupAnimation="Fade"
                   HorizontalOffset="{DynamicResource MenuPopupHorizontalOffset}">
                <Border Margin="{DynamicResource MenuSidePopupMargin}"
                        Padding="{DynamicResource MenuPopupPadding}"
                        Background="{DynamicResource MenuPopupBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource MenuPopupCornerRadius}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black"
                                          Opacity="{DynamicResource MenuShadowOpacity}" />
                    </Border.Effect>
                    <ScrollViewer CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemPressedBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemPressedBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MenuPressedTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MenuItemDisabledTextBrush}" />
                <Setter TargetName="CheckMark" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="ItemBorder"
                MinWidth="180"
                MinHeight="{DynamicResource MenuItemMinHeight}"
                    Padding="{DynamicResource MenuSubContentPadding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource MenuItemCornerRadius}"
                SnapsToDevicePixels="True">
            <Grid Margin="{DynamicResource MenuContentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource MenuIconColumnWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{DynamicResource MenuArrowColumnWidth}" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0"
                                  ContentSource="Icon"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <Path x:Name="CheckMark"
                      Grid.Column="0"
                      Width="{DynamicResource MenuCheckWidth}"
                      Height="{DynamicResource MenuCheckHeight}"
                      Data="{DynamicResource MenuCheckGeometry}"
                      Stroke="{DynamicResource MenuCheckStrokeBrush}"
                          Fill="{DynamicResource MenuCheckFillBrush}"
                      StrokeThickness="{DynamicResource MenuCheckStrokeWidth}"
                      StrokeEndLineCap="Square"
                      Visibility="Collapsed" />
                <ContentPresenter Grid.Column="1"
                                  Margin="{DynamicResource MenuTextMargin}"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Margin="{DynamicResource MenuGestureMargin}"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding InputGestureText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemHoverBrush}" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource MenuItemHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuItemPressedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource MenuPressedTextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource MenuItemDisabledTextBrush}" />
                <Setter TargetName="CheckMark" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource MenuBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
        <Setter Property="MinHeight" Value="{DynamicResource MenuMinHeight}" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Tag" Value="{DynamicResource UseModernTheme}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="Background" Value="{DynamicResource MenuPopupBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource ModernMenuEnabled}">
                <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisual}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Background" Value="{DynamicResource MenuBrush}" />
                <Setter Property="Padding" Value="{DynamicResource MenuTopItemPadding}" />
                <Setter Property="Margin" Value="{DynamicResource MenuTopItemMargin}" />
                <Setter Property="Template" Value="{StaticResource TopLevelMenuHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Background" Value="{DynamicResource MenuBrush}" />
                <Setter Property="Padding" Value="{DynamicResource MenuTopItemPadding}" />
                <Setter Property="Margin" Value="{DynamicResource MenuTopItemMargin}" />
                <Setter Property="Template" Value="{StaticResource TopLevelMenuItemTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{DynamicResource MenuSeparatorMargin}" />
        <Setter Property="Background" Value="{DynamicResource MenuSeparatorBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ModernContextMenuTemplate" TargetType="ContextMenu">
        <Border Margin="12,2,12,12" Padding="{DynamicResource MenuPopupPadding}"
                Background="{DynamicResource MenuPopupBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource MenuPopupCornerRadius}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black"
                                  Opacity="{DynamicResource MenuShadowOpacity}" />
            </Border.Effect>
            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
        </Border>
    </ControlTemplate>
    <Style TargetType="ContextMenu">
        <Setter Property="Tag" Value="{DynamicResource UseModernTheme}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource ModernMenuEnabled}">
                <Setter Property="Template" Value="{StaticResource ModernContextMenuTemplate}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
