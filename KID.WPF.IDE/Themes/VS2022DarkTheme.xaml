<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:codeEditor="clr-namespace:KID.Services.CodeEditor">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="VS2022Metrics.xaml" />
        <ResourceDictionary Source="MenuStyles.xaml" />
        <ResourceDictionary Source="WindowStyles.xaml" />
        <ResourceDictionary Source="EditorTabStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <codeEditor:VS2022DarkClassificationHighlightColors
        x:Key="{x:Static codeEditor:ClassificationHighlightColorsProvider.CodeEditorClassificationColors}" />

    <!-- Цвета -->
    <Color x:Key="WindowBackground">#1F1F1F</Color>
    <Color x:Key="MenuBackground">#1F1F1F</Color>
    <Color x:Key="SplitterColor">#1F1F1F</Color>
    <Color x:Key="EditorBackground">#1E1E1E</Color>
    <Color x:Key="EditorForeground">#D4D4D4</Color>
    <Color x:Key="SpecialElementsBackground">#424242</Color>
    <Color x:Key="TextColor">White</Color>
    <Color x:Key="ConsoleBackground">Black</Color>
    <Color x:Key="ConsoleForeground">White</Color>
    <Color x:Key="CanvasBackground">#D3D3D3</Color>
    <Color x:Key="WindowBorder">#606060</Color>

    <!-- Семантические цвета меню и кнопок окна -->
    <Color x:Key="MenuPopupBackground">#252525</Color>
    <Color x:Key="MenuItemHoverBackground">#3A3A3A</Color>
    <Color x:Key="MenuItemPressedBackground">#505050</Color>
    <Color x:Key="MenuItemDisabledText">#8A8A8A</Color>
    <Color x:Key="MenuBorder">#606060</Color>
    <Color x:Key="MenuSeparator">#606060</Color>
    <Color x:Key="MenuIndicator">#FFFFFF</Color>
    <Color x:Key="WindowButtonHoverBackground">#3A3A3A</Color>
    <Color x:Key="WindowButtonPressedForeground">#FFFFFF</Color>

    <!-- Цвета вкладок редактора -->
    <Color x:Key="TabActiveBackground">#7160E8</Color>
    <Color x:Key="TabInactiveBackground">#2E2E2E</Color>
    <Color x:Key="TabBarBackground">#1F1F1F</Color>
    <Color x:Key="TabActiveText">#FFFFFF</Color>
    <Color x:Key="TabInactiveText">#B0B0B0</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MenuBrush" Color="{StaticResource MenuBackground}" />
    <SolidColorBrush x:Key="SplitterBrush" Color="{StaticResource SplitterColor}" />
    <SolidColorBrush x:Key="SpecialElementsBrush" Color="{StaticResource SpecialElementsBackground}" />
    <SolidColorBrush x:Key="EditorBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource EditorForeground}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="{StaticResource ConsoleBackground}" />
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleForeground}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasBackground}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorder}" />
    <SolidColorBrush x:Key="MenuPopupBrush" Color="{StaticResource MenuPopupBackground}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{StaticResource MenuItemHoverBackground}" />
    <SolidColorBrush x:Key="MenuItemPressedBrush" Color="{StaticResource MenuItemPressedBackground}" />
    <SolidColorBrush x:Key="MenuItemDisabledTextBrush" Color="{StaticResource MenuItemDisabledText}" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource MenuBorder}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{StaticResource MenuSeparator}" />
    <SolidColorBrush x:Key="MenuIndicatorBrush" Color="{StaticResource MenuIndicator}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="{StaticResource WindowButtonHoverBackground}" />
    <SolidColorBrush x:Key="WindowButtonPressedForegroundBrush" Color="{StaticResource WindowButtonPressedForeground}" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource TabActiveBackground}" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="{StaticResource TabInactiveBackground}" />
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="{StaticResource TabBarBackground}" />
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="{StaticResource TabActiveText}" />
    <SolidColorBrush x:Key="TabInactiveTextBrush" Color="{StaticResource TabInactiveText}" />

    <!-- Стили элементов -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource EditorBrush}"/>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource SplitterBrush}" />
    </Style>

    <!-- Стиль кнопок управления -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WindowButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WindowButtonPressedForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Дополнительные роли общих шаблонов; прежние цвета VS2022 сохранены. -->
    <SolidColorBrush x:Key="TitleInactiveBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="WindowInactiveBorderBrush" Color="{StaticResource WindowBorder}" />
    <SolidColorBrush x:Key="MenuItemHoverBorderBrush" Color="{StaticResource MenuBorder}" />
    <SolidColorBrush x:Key="MenuItemPressedBorderBrush" Color="{StaticResource MenuBorder}" />
    <SolidColorBrush x:Key="MenuPressedTextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TabHoverBorderBrush" Color="{StaticResource TabInactiveBackground}" />
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="{StaticResource TabActiveBackground}" />
    <SolidColorBrush x:Key="TabInactiveWindowBorderBrush" Color="{StaticResource TabActiveBackground}" />
    <SolidColorBrush x:Key="TabScrollThumbBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="ThemeFocusBrush" Color="{StaticResource MenuIndicator}" />
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="MenuShadowOpacity">0</sys:Double>
    <Style x:Key="MinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}" />
    <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}" />
    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}" />

    <SolidColorBrush x:Key="MenuCheckFillBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MenuCheckStrokeBrush" Color="{StaticResource MenuIndicator}" />
    <SolidColorBrush x:Key="MenuChevronFillBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MenuChevronStrokeBrush" Color="{StaticResource MenuIndicator}" />
</ResourceDictionary>
