<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- WPF-типы важны: Height и RowDefinition.Height используют разные типы. -->
    <sys:Boolean x:Key="UseModernTheme">False</sys:Boolean>
    <sys:Double x:Key="WindowTitleHeight">32</sys:Double>
    <GridLength x:Key="WindowTitleRowHeight">32</GridLength>
    <sys:Double x:Key="WindowIconSize">30</sys:Double>
    <Thickness x:Key="WindowIconMargin">7.5,0,0,0</Thickness>
    <Thickness x:Key="WindowTitleMargin">7.5,0,0,0</Thickness>
    <sys:Double x:Key="WindowTitleFontSize">13</sys:Double>
    <FontWeight x:Key="WindowTitleFontWeight">Bold</FontWeight>
    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="UiFontSize">12</sys:Double>
    <Thickness x:Key="WorkspaceContentMargin">5</Thickness>
    <Thickness x:Key="MenuBottomMargin">0,0,0,5</Thickness>
    <sys:Double x:Key="MenuMinHeight">0</sys:Double>
    <Thickness x:Key="MenuTopItemPadding">10,2</Thickness>
    <Thickness x:Key="MenuTopItemMargin">0</Thickness>
    <Thickness x:Key="MenuSubContentPadding">0</Thickness>
    <sys:Double x:Key="MenuItemMinHeight">26</sys:Double>
    <CornerRadius x:Key="MenuItemCornerRadius">0</CornerRadius>
    <Thickness x:Key="MenuPopupPadding">2</Thickness>
    <CornerRadius x:Key="MenuPopupCornerRadius">2</CornerRadius>
    <Thickness x:Key="MenuTopPopupMargin">0,1,0,0</Thickness>
    <Thickness x:Key="MenuSidePopupMargin">-1,0,0,0</Thickness>
    <sys:Double x:Key="MenuPopupHorizontalOffset">0</sys:Double>
    <Thickness x:Key="MenuContentMargin">4,0</Thickness>
    <GridLength x:Key="MenuIconColumnWidth">22</GridLength>
    <GridLength x:Key="MenuArrowColumnWidth">18</GridLength>
    <Thickness x:Key="MenuTextMargin">3,0,12,0</Thickness>
    <Thickness x:Key="MenuGestureMargin">12,0,4,0</Thickness>
    <Thickness x:Key="MenuSeparatorMargin">28,3,6,3</Thickness>
    <Thickness x:Key="TabStripPadding">7,5,2,0</Thickness>
    <Thickness x:Key="TabStripScrollingPadding">7,0,2,0</Thickness>
    <Thickness x:Key="TabMargin">2,0,0,0</Thickness>
    <Thickness x:Key="TabPadding">10,2,4,2</Thickness>
    <sys:Double x:Key="TabMinHeight">0</sys:Double>
    <Thickness x:Key="TabBorderThickness">0</Thickness>
    <CornerRadius x:Key="TabCornerRadius">0</CornerRadius>
    <FontWeight x:Key="TabSelectedFontWeight">Bold</FontWeight>
    <Thickness x:Key="TabTextMargin">0,0,8,0</Thickness>
    <sys:Double x:Key="TabCloseButtonSize">18</sys:Double>
    <sys:Double x:Key="TabScrollBarHeight">4</sys:Double>
    <CornerRadius x:Key="TabCloseCornerRadius">0</CornerRadius>
    <sys:Double x:Key="MenuCheckWidth">11</sys:Double>
    <sys:Double x:Key="MenuCheckHeight">8</sys:Double>
    <sys:Double x:Key="MenuCheckStrokeWidth">2</sys:Double>
    <sys:Double x:Key="MenuChevronWidth">5</sys:Double>
    <sys:Double x:Key="MenuChevronHeight">9</sys:Double>
    <sys:Double x:Key="MenuChevronStrokeWidth">1.5</sys:Double>
    <Geometry x:Key="MenuCheckGeometry">M 0 4 L 3.5 7.5 L 11 0</Geometry>
    <Geometry x:Key="MenuChevronGeometry">M 0 0 L 4 4.5 L 0 9</Geometry>
</ResourceDictionary>
