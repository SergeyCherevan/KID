<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:codeEditor="clr-namespace:KID.Services.CodeEditor">
    <!-- VS2026 18.10.3; источники и ограничения: docs/references/VS2026_UI_REFERENCE.md. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="VS2026Metrics.xaml" />
        <ResourceDictionary Source="MenuStyles.xaml" />
        <ResourceDictionary Source="WindowStyles.xaml" />
        <ResourceDictionary Source="EditorTabStyles.xaml" />
        <ResourceDictionary Source="EditorScrollStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <codeEditor:VS2026DarkClassificationHighlightColors x:Key="{x:Static codeEditor:ClassificationHighlightColorsProvider.CodeEditorClassificationColors}" />
    <!-- Цвета геометрических значков запуска и остановки. -->
    <Color x:Key="MenuRunIconColor">#80CE80</Color>
    <Color x:Key="MenuStopIconColor">#F06A6A</Color>
    <Color x:Key="WindowBackground">#FF1F1F1F</Color>
    <Color x:Key="WindowTitleForeground">#FFFAFAFA</Color>
    <Color x:Key="WindowTitleInactiveForeground">#FFD6D6D6</Color>
    <Color x:Key="MenuBackground">#FF1F1F1F</Color>
    <Color x:Key="SplitterColor">#FF1C1C1C</Color>
    <Color x:Key="SpecialElementsBackground">#FF1C1C1C</Color>
    <Color x:Key="EditorBackground">#FF1E1E1E</Color>
    <Color x:Key="EditorForeground">#FFDCDCDC</Color>
    <Color x:Key="TextColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#C8FFFFFF</Color>
    <Color x:Key="ConsoleBackground">#FF282828</Color>
    <Color x:Key="ConsoleForeground">#FFF1F1F1</Color>
    <Color x:Key="CanvasBackground">#FFD3D3D3</Color>
    <Color x:Key="WindowBorder">#FF9184EE</Color>
    <Color x:Key="WindowInactiveBorder">#FF454545</Color>
    <Color x:Key="MenuPopupBackground">#FF2C2C2C</Color>
    <Color x:Key="MenuItemHoverBackground">#0FFFFFFF</Color>
    <Color x:Key="MenuItemPressedBackground">#0BFFFFFF</Color>
    <Color x:Key="MenuItemDisabledText">#5DFFFFFF</Color>
    <Color x:Key="MenuBorder">#33000000</Color>
    <Color x:Key="MenuItemHoverBorder">#12FFFFFF</Color>
    <Color x:Key="MenuItemPressedBorder">#0BFFFFFF</Color>
    <Color x:Key="MenuSeparator">#15FFFFFF</Color>
    <Color x:Key="MenuIndicator">#FFFFFFFF</Color>
    <Color x:Key="WindowButtonHoverBackground">#0FFFFFFF</Color>
    <Color x:Key="WindowButtonPressedBackground">#0BFFFFFF</Color>
    <Color x:Key="WindowButtonPressedForeground">#C8FFFFFF</Color>
    <Color x:Key="WindowButtonInactiveForeground">#8BFFFFFF</Color>
    <Color x:Key="CloseButtonHoverBackground">#FFC42B1C</Color>
    <Color x:Key="CloseButtonPressedBackground">#E6C42B1C</Color>
    <Color x:Key="CloseButtonHoverForeground">#FFFFFFFF</Color>
    <Color x:Key="CloseButtonPressedForeground">#B3FFFFFF</Color>
    <Color x:Key="TabActiveBackground">#FF282828</Color>
    <Color x:Key="TabInactiveBackground">#00FFFFFF</Color>
    <Color x:Key="TabBarBackground">#FF1C1C1C</Color>
    <Color x:Key="TabActiveText">#FFFFFFFF</Color>
    <Color x:Key="TabInactiveText">#C8FFFFFF</Color>
    <Color x:Key="TabActiveBorder">#FF9184EE</Color>
    <Color x:Key="TabHoverBorder">#0FFFFFFF</Color>
    <Color x:Key="TabScrollThumb">#8BFFFFFF</Color>
    <Color x:Key="ThemeFocusColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowBackground}" />
    <SolidColorBrush x:Key="TitleBrush" Color="{StaticResource WindowTitleForeground}" />
    <SolidColorBrush x:Key="TitleInactiveBrush" Color="{StaticResource WindowTitleInactiveForeground}" />
    <SolidColorBrush x:Key="MenuBrush" Color="{StaticResource MenuBackground}" />
    <SolidColorBrush x:Key="SplitterBrush" Color="{StaticResource SplitterColor}" />
    <SolidColorBrush x:Key="SpecialElementsBrush" Color="{StaticResource SpecialElementsBackground}" />
    <SolidColorBrush x:Key="EditorBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackground}" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource EditorForeground}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="{StaticResource ConsoleBackground}" />
    <SolidColorBrush x:Key="ConsoleTextBrush" Color="{StaticResource ConsoleForeground}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasBackground}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorder}" />
    <SolidColorBrush x:Key="WindowInactiveBorderBrush" Color="{StaticResource WindowInactiveBorder}" />
    <SolidColorBrush x:Key="MenuPopupBrush" Color="{StaticResource MenuPopupBackground}" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="{StaticResource MenuItemHoverBackground}" />
    <SolidColorBrush x:Key="MenuItemPressedBrush" Color="{StaticResource MenuItemPressedBackground}" />
    <SolidColorBrush x:Key="MenuItemDisabledTextBrush" Color="{StaticResource MenuItemDisabledText}" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="{StaticResource MenuBorder}" />
    <SolidColorBrush x:Key="MenuItemHoverBorderBrush" Color="{StaticResource MenuItemHoverBorder}" />
    <SolidColorBrush x:Key="MenuItemPressedBorderBrush" Color="{StaticResource MenuItemPressedBorder}" />
    <SolidColorBrush x:Key="MenuPressedTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="{StaticResource MenuSeparator}" />
    <SolidColorBrush x:Key="MenuIndicatorBrush" Color="{StaticResource MenuIndicator}" />
    <SolidColorBrush x:Key="WindowButtonHoverBrush" Color="{StaticResource WindowButtonHoverBackground}" />
    <SolidColorBrush x:Key="WindowButtonPressedBackgroundBrush" Color="{StaticResource WindowButtonPressedBackground}" />
    <SolidColorBrush x:Key="WindowButtonPressedForegroundBrush" Color="{StaticResource WindowButtonPressedForeground}" />
    <SolidColorBrush x:Key="WindowButtonInactiveForegroundBrush" Color="{StaticResource WindowButtonInactiveForeground}" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="{StaticResource CloseButtonHoverBackground}" />
    <SolidColorBrush x:Key="CloseButtonPressedBrush" Color="{StaticResource CloseButtonPressedBackground}" />
    <SolidColorBrush x:Key="CloseButtonHoverForegroundBrush" Color="{StaticResource CloseButtonHoverForeground}" />
    <SolidColorBrush x:Key="CloseButtonPressedForegroundBrush" Color="{StaticResource CloseButtonPressedForeground}" />
    <SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource TabActiveBackground}" />
    <SolidColorBrush x:Key="TabInactiveBrush" Color="{StaticResource TabInactiveBackground}" />
    <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="{StaticResource TabBarBackground}" />
    <SolidColorBrush x:Key="TabActiveTextBrush" Color="{StaticResource TabActiveText}" />
    <SolidColorBrush x:Key="TabInactiveTextBrush" Color="{StaticResource TabInactiveText}" />
    <SolidColorBrush x:Key="TabActiveBorderBrush" Color="{StaticResource TabActiveBorder}" />
    <SolidColorBrush x:Key="TabInactiveWindowBorderBrush" Color="{StaticResource WindowInactiveBorder}" />
    <SolidColorBrush x:Key="TabHoverBorderBrush" Color="{StaticResource TabHoverBorder}" />
    <SolidColorBrush x:Key="TabScrollThumbBrush" Color="{StaticResource TabScrollThumb}" />
    <SolidColorBrush x:Key="ThemeFocusBrush" Color="{StaticResource ThemeFocusColor}" />
    <sys:Double x:Key="MenuShadowOpacity">0.2588235294</sys:Double>
    <Style x:Key="WindowButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernWindowButtonStyle}" />
    <Style x:Key="MinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernMinimizeButtonStyle}" />
    <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernMaximizeButtonStyle}" />
    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernCloseButtonStyle}" />
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style TargetType="GridSplitter"><Setter Property="Background" Value="{DynamicResource SplitterBrush}" /></Style>
    <SolidColorBrush x:Key="MenuCheckFillBrush" Color="{StaticResource MenuIndicator}" />
    <SolidColorBrush x:Key="MenuCheckStrokeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MenuChevronFillBrush" Color="{StaticResource MenuIndicator}" />
    <SolidColorBrush x:Key="MenuChevronStrokeBrush" Color="Transparent" />
</ResourceDictionary>
