<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Структура общая; изменяемые значения разрешаются в активной теме. -->
    <Style x:Key="ThemeFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource ThemeFocusBrush}" BorderThickness="2"
                            CornerRadius="6" Margin="-3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WindowFrameStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource WindowInactiveBorderBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="WindowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TitleBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource WindowTitleFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource WindowTitleFontWeight}" />
        <Setter Property="Margin" Value="{DynamicResource WindowTitleMargin}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TitleInactiveBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModernWindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}"
                              Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource WindowButtonInactiveForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowButtonHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MenuItemHoverBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource WindowButtonPressedBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource WindowButtonPressedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource WindowButtonPressedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModernMinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernWindowButtonStyle}">
        <Setter Property="Tag" Value="{DynamicResource MinimizeButtonPath}" />
    </Style>
    <Style x:Key="ModernMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernWindowButtonStyle}">
        <Setter Property="Tag" Value="{DynamicResource MaximizeRestoreButtonPath}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Tag" Value="{DynamicResource RestoreButtonPath}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModernCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernWindowButtonStyle}">
        <Setter Property="Tag" Value="{DynamicResource HideButtonPath}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CloseButtonHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CloseButtonHoverForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CloseButtonPressedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CloseButtonPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CloseButtonPressedForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
