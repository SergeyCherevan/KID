<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>KID.Standalone.ContractProbe.D005</AssemblyName>
    <RootNamespace>KID.StandaloneProbe</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StandaloneContractStage Condition="'$(StandaloneContractStage)' == ''">Regression</StandaloneContractStage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\KID.Library\KID.Library.csproj" />
    <Compile Include="Program.cs" />
    <Compile Include="Scenarios\$(StandaloneContractStage).cs" />
  </ItemGroup>

  <Target Name="ValidateStandaloneContractStage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(StandaloneContractStage)' != 'Regression' and '$(StandaloneContractStage)' != 'Session' and '$(StandaloneContractStage)' != 'SessionFailure' and '$(StandaloneContractStage)' != 'CanvasSwitching' and '$(StandaloneContractStage)' != 'CanvasObjects'"
           Text="StandaloneContractStage must be Regression, Session, SessionFailure, CanvasSwitching or CanvasObjects." />
  </Target>
</Project>
